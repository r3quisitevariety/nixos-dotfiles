// MAIN LAPTOP SCREEN
output "eDP-1" {
    off
    mode "1920x1080@144.000"
    scale 1
    position x=0 y=0
    variable-refresh-rate on-demand=true
}
// EXTERNAL MONITOR
output "HDMI-A-1" {
    //off
    mode "1920x1080@144.000"
    scale 1
    position x=0 y=0
    variable-refresh-rate on-demand=true
}
// GPU
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
    emulate-zero-presentation-time
}
// STARTUP
spawn-at-startup "kitty" "--single-instance" "--start-as=hidden" "tail" "-f" "/dev/null"
spawn-at-startup "vellum"
spawn-at-startup "noctalia"
// DISABLE MIDDLE CLICK PASTE
clipboard {
    disable-primary
}
// INPUT
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        natural-scroll
        tap
    }
    mouse {

    }
    focus-follows-mouse
}
// ENVIRONMENT
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "16"
}
// WORKSPACES (PERSISTENT)
workspace "1" {

}
workspace "2" {

}
workspace "3" {

}
workspace "4" {

}
workspace "5" {

}
workspace "6" {

}
workspace "7" {

}
workspace "8" {

}
workspace "9" {

}
// LAYOUT
layout {
    gaps 10
    focus-ring {
        on
        width 1
    }
    border {
        off
    }
    shadow {
        on
        softness 4
        spread 3
        offset x=0 y=0
        color "#1a1a1aee"
    }
    // Column width presets (Mod+R cycles through these)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }
}
// WINDOW RULES
prefer-no-csd
blur {
    passes 4
    offset 3.0
    noise 0.02
    saturation 1.5
}
window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
}
window-rule {
    match app-id="zed"
    draw-border-with-background false
}
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}
window-rule {
    match app-id="zen"
    draw-border-with-background false
    default-column-width {
        proportion 1.0
    }
}
window-rule {
    match app-id="vesktop"
    draw-border-with-background false
    default-column-width {
        proportion 1.0
    }
}
window-rule {
    match app-id="electron"
    match title="Obsidian"
    default-column-width {
        proportion 1.0
    }
}
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
animations {
    // credit to https://github.com/Xansidev/nirimation for the swipe-window animation
    window-open {
        duration-ms 1400
        curve "ease-out-expo"
        custom-shader "\n            float ease_curve(float x) {\n                return x < 0.5 ? 4.0*x*x*x : 1.0 - pow(-2.0*x + 2.0, 3.0)/2.0;\n            }\n\n            vec4 open_color(vec3 coords_geo, vec3 size_geo) {\n                float t = niri_clamped_progress;\n                float prog = ease_curve(t);\n\n                // choose corner: 0=top-left,1=top-right,2=bottom-left,3=bottom-right\n\n                int corner = 3; \n                vec2 start;\n                vec2 dir;\n                if (corner == 0) {\n                    start = vec2(0.0,0.0);\n                    dir = vec2(1.0,1.0);\n                } else if (corner == 1) {\n                    start = vec2(1.0,0.0);\n                    dir = vec2(-1.0,1.0);\n                } else if (corner == 2) {\n                    start = vec2(0.0,1.0);\n                    dir = vec2(1.0,-1.0);\n                } else {\n                    start = vec2(1.0,1.0);\n                    dir = vec2(-1.0,-1.0);\n                }\n\n                // compute distance along diagonal from corner\n                vec2 p = coords_geo.xy;\n                float dist = dot(p - start, dir);\n\n                // normalize distance to max diagonal (from corner to opposite)\n                float max_diag = 2.0;\n                float norm_dist = dist / max_diag;\n\n                // pixels not yet reached by sweep are invisible\n                if (norm_dist > prog) {\n                    return vec4(0.0);\n                }\n\n                // sample normally\n                vec3 coords_tex = niri_geo_to_tex * coords_geo;\n                vec4 col = texture2D(niri_tex, coords_tex.xy);\n\n                return col;\n            }\n        "
    }
    window-close {
        duration-ms 1400
        curve "ease-out-expo"
        custom-shader "\n            // ease-in-out cubic curve helper\n            float ease_curve(float x) {\n                return x < 0.5 ? 4.0*x*x*x : 1.0 - pow(-2.0*x + 2.0, 3.0)/2.0;\n            }\n\n            vec4 close_color(vec3 coords_geo, vec3 size_geo) {\n                float t = niri_clamped_progress;\n\n\n                float prog = ease_curve(t);\n\n                // choose corner: 0=top-left,1=top-right,2=bottom-left,3=bottom-right\n\n                int corner = 0; \n                vec2 start;\n                vec2 dir;\n                if (corner == 0) {\n                    start = vec2(0.0,0.0);\n                    dir = vec2(1.0,1.0);\n                } else if (corner == 1) {\n                    start = vec2(1.0,0.0);\n                    dir = vec2(-1.0,1.0);\n                } else if (corner == 2) {\n                    start = vec2(0.0,1.0);\n                    dir = vec2(1.0,-1.0);\n                } else {\n                    start = vec2(1.0,1.0);\n                    dir = vec2(-1.0,-1.0);\n                }\n\n                float shadow_fix = 0.01; // otherwise the animation may stop before \n                // it hides the shadow, since it's outside the window bounds\n\n                // compute distance along diagonal from corner\n\n                vec2 p = coords_geo.xy;\n                float dist = dot(p - start, dir) - shadow_fix;\n\n                // normalize distance to max diagonal\n                float max_diag = 2.0; // max of vec2(1,1)\n                float norm_dist = dist / max_diag;\n\n\n                // If pixel is behind the sweeping line, make it invisible\n\n                if (norm_dist <= prog) {\n                    return vec4(0.0);\n                }\n\n                // sample normally\n                vec3 coords_tex = niri_geo_to_tex * coords_geo;\n                vec4 col = texture2D(niri_tex, coords_tex.xy);\n\n                return col;\n            }\n        "
    }
    window-resize {
        custom-shader "\n            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {\n                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;\n                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);\n                return color;\n            }\n        "
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay {
    skip-at-startup
}
// BINDS
binds {
    Mod+A {
        spawn "vellum" "toggle"
    }
    // Show hotkey overlay (niri built-in help)
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    Mod+Tab {
        toggle-overview
    }
    // Terminal (kitty)
    Mod+Q {
        spawn "kitty" "--single-instance"
    }
    Mod+D {
        spawn-sh "noctalia msg panel-open launcher"
    }
    // File manager (nautilus)
    Mod+E {
        spawn "nautilus"
    }
    // Close window (replaces killactive)
    Mod+C {
        close-window
    }
    // Fullscreen (maximize column + actual fullscreen)
    Mod+F {
        maximize-column
    }
    Mod+Shift+F {
        fullscreen-window
    }
    // Toggle floating
    Mod+V {
        toggle-window-floating
    }
    // Quit niri
    Mod+M {
        quit
    }
    // ── Focus and column movement (vim keys) ───────────────────────────────────
    Mod+H {
        focus-column-left
    }
    Mod+Shift+WheelScrollUp {
        focus-column-left
    }
    Mod+Shift+WheelScrollDown {
        focus-column-right
    }
    Mod+WheelScrollUp {
        focus-workspace-up
    }
    Mod+WheelScrollDown {
        focus-workspace-down
    }
    Mod+K {
        focus-workspace-up
    }
    Mod+J {
        focus-workspace-down
    }
    Mod+L {
        focus-column-right
    }
    Mod+Ctrl+H {
        move-column-left
    }
    Mod+CTRL+J {
        move-column-to-workspace-down
    }
    Mod+CTRL+K {
        move-column-to-workspace-up
    }
    Mod+Ctrl+L {
        move-column-right
    }
    Mod+Shift+H {
        set-column-width "-10%"
    }
    Mod+Shift+L {
        set-column-width "+10%"
    }
    Mod+Shift+K {
        set-window-height "-10%"
    }
    Mod+Shift+J {
        set-window-height "+10%"
    }
    // ── Workspace switching (Mod+1-9) ──────────────────────────────────────────
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    // ── Move window to workspace (Mod+Shift+1-9) ──────────────────────────────
    Mod+Shift+1 {
        move-column-to-workspace 1
    }
    Mod+Shift+2 {
        move-column-to-workspace 2
    }
    Mod+Shift+3 {
        move-column-to-workspace 3
    }
    Mod+Shift+4 {
        move-column-to-workspace 4
    }
    Mod+Shift+5 {
        move-column-to-workspace 5
    }
    Mod+Shift+6 {
        move-column-to-workspace 6
    }
    Mod+Shift+7 {
        move-column-to-workspace 7
    }
    Mod+Shift+8 {
        move-column-to-workspace 8
    }
    Mod+Shift+9 {
        move-column-to-workspace 9
    }
    // ── Column width cycling (replaces pseudo/dwindle feel) ───────────────────
    Mod+R {
        switch-preset-column-width
    }
    // ── Screenshots ───────────────────────────────────────────────────────────
    Print {
        screenshot
    }
    Mod+S {
        screenshot-screen
    }
    Mod+Shift+S {
        screenshot
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    }
    // Brightness
    XF86MonBrightnessUp allow-when-locked=true {
        spawn "brightnessctl" "s" "10%+"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "s" "10%-"
    }
    // Media control (playerctl)
    XF86AudioPlay allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }
    XF86AudioPause allow-when-locked=true {
        spawn "playerctl" "play-pause"
    }
    XF86AudioNext allow-when-locked=true {
        spawn "playerctl" "next"
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "playerctl" "previous"
    }
}
include "./noctalia.kdl"
